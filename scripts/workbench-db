#!/bin/sh
set -eu

if command -v node >/dev/null 2>&1; then
  NODE="$(command -v node)"
elif [ -x /workspace/.runtime/node-v22.23.1/bin/node ]; then
  NODE=/workspace/.runtime/node-v22.23.1/bin/node
else
  printf '%s\n' '{"error":"Node.js 22 or newer is required"}' >&2
  exit 1
fi

exec "$NODE" "$(dirname "$0")/workbench-db.mjs" "$@"
